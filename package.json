{
  "name": "o-mundo-a-partir-do-utero",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode desenvolvimento",
    "build": "tsc --noEmit && vite build --mode producao",
    "build:lab": "tsc --noEmit && vite build --mode desenvolvimento",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src",
    "check:release": "node --experimental-strip-types scripts/check-release.ts",
    "verificar:dist": "node scripts/verificar-dist.mjs",
    "release:verificar": "npm run typecheck && npm run test && npm run build && npm run verificar:dist && npm run check:release",
    "e2e": "playwright test"
  },
  "dependencies": {
    "idb": "^8.0.2",
    "preact": "^10.25.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.9.3",
    "@types/node": "^22.13.4",
    "fake-indexeddb": "^6.0.0",
    "typescript": "~5.7.2",
    "vite": "^6.1.0",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^3.0.6"
  }
}
